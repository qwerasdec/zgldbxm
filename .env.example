# 使用火山方舟时：密钥写在 ARK_API_KEY；AI_BASE_URL 含 volces/ark 时服务端会优先用 ARK_API_KEY，
# 避免 AI_API_KEY 里残留占位符导致 401「Api key is invalid」。
ARK_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-1-8-251228

# 文字转写（大陆可用，OpenAI 兼容 POST /v1/audio/transcriptions）。注册硅基流动等获取密钥：
# https://docs.siliconflow.cn/cn/api-reference/audio/create-audio-transcriptions
STT_API_KEY=
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# 信令 HTTP 端口（与 Vite 开发代理目标一致，默认 3001）
PORT=3001

# 本地开发：npm run dev 后使用 https://localhost:5173（自签证书点「高级」继续即可）
# 另开终端运行 npm run signal

# 用 IP 上线且 Nginx 反代 /socket.io、/api 时：构建前不必设置（前端自动用当前页地址）。
# 仅当信令在别的域名/端口时才填，例如：
# VITE_SIGNAL_SERVER_URL=https://112.124.13.31

# MySQL 数据库（配置后会议记录/预约会议会持久化到数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=zglxm
